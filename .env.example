# HMI COPILOT — environment variables (names only; never commit real values).
# Local dev: copy to .env.local. Production (Render): set in the dashboard / render.yaml.

# ---- Central AI (optional) ---------------------------------------------------
# When set, /api/copilot routes conversational explanations to Groq to phrase
# the reply. Groq NEVER produces numbers, decisions, or control actions — the
# deterministic edge context engine runs first and its output is fixed.
# When unset, the Copilot answers entirely from the local rule engine.
# MUST be a server-side var. NEVER prefix with NEXT_PUBLIC_.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Chat model for the phrasing step. Default when unset: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# ---- Hosting ---------------------------------------------------------------
# PORT is provided by the host (Render sets it automatically); `next start`
# binds it. Do not hard-code a port in production.
# PORT=3000

# NODE_VERSION pins the runtime on Render (see also .node-version).
# NODE_VERSION=22.11.0

# ---- Legacy build only ----------------------------------------------------
# The archived predictive-maintenance pages (/dashboard, /assistant, …) reuse
# GROQ_API_KEY for their Engineering Report; no separate variable is needed.
