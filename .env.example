# HMI COPILOT — environment variables (names only; never commit real values).
# Local dev: copy to .env.local. Production: set in the Vercel project settings.

# ---- Central AI (optional) ---------------------------------------------------
# When set, /api/copilot routes conversational explanations to Groq to phrase
# the reply. Groq NEVER produces numbers, decisions, or control actions — the
# deterministic edge context engine runs first and its output is fixed.
# When unset, the Copilot answers entirely from the local rule engine.
#
# Server-side only. NEVER prefix with NEXT_PUBLIC_. In Vercel, add it under
# Project → Settings → Environment Variables (Production + Preview).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Chat model for the phrasing step. Default when unset: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# ---- Notes -----------------------------------------------------------------
# PORT is provided by the host; `next start` / Vercel bind it automatically.
# The archived predictive-maintenance pages reuse GROQ_API_KEY — no extra var.
